# Copy to .env and fill in. Never commit real values.
# Host is the Postgres container name (resolved over the datanet network).
DATABASE_URL=postgresql://mediahub:<password>@postgres:5432/mediahub

# Watching features (now-playing + genre): create a key at
# Jellyfin -> Dashboard -> API Keys, then paste here.
JELLYFIN_URL=http://10.0.0.10:8096
JELLYFIN_API_KEY=<jellyfin-api-key>
POLL_MINUTES=5

# File-audit purge: 1 = auto-delete empty folders, 0 = dry-run (report only)
AUDIT_PURGE_EMPTIES=1
MEDIA_BASE=/data/media
